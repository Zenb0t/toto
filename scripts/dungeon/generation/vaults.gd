static func random_name(rng: RandomNumberGenerator) -> String:
	var names := DESIGNS.keys()
	return names[rng.randi_range(0, names.size() - 1)]


## The vault's cells as {cell: map symbol}, centred in bounds and randomly mirrored, so one design reads as up
## to four. Wall symbols are left out: they are simply not part of the room.
static func stamp(vault_name: String, bounds: Rect2i, rng: RandomNumberGenerator) -> Dictionary:
	assert(bounds.size.x >= SIZE.x and bounds.size.y >= SIZE.y, "vault does not fit")
	var rows: PackedStringArray = DESIGNS[vault_name].strip_edges().split("
")
	var top_left := bounds.position + (bounds.size - SIZE) / 2
	var flip_x := rng.randi() % 2 == 0
	var flip_y := rng.randi() % 2 == 0
	var cells := {}
	for y in SIZE.y:
		for x in SIZE.x:
			var symbol := rows[SIZE.y - 1 - y if flip_y else y][SIZE.x - 1 - x if flip_x else x]
			if symbol != DungeonMapParser.WALL:
				cells[top_left + Vector2i(x, y)] = symbol
	return cells
